#ifndef CHART_VIEW_BUILD_CONFIG_HPP
#define CHART_VIEW_BUILD_CONFIG_HPP

#include <cstdint>
#include <string_view>

namespace chart_view::build {
inline constexpr std::string_view project_name = "@PROJECT_NAME@";
inline constexpr std::string_view project_version = "@PROJECT_VERSION@";
inline constexpr std::string_view git_sha = "@GIT_SHA@";
inline constexpr std::uint32_t project_version_major = @PROJECT_VERSION_MAJOR@;
inline constexpr std::uint32_t project_version_minor = @PROJECT_VERSION_MINOR@;
inline constexpr std::uint32_t project_version_patch = @PROJECT_VERSION_PATCH@;
inline constexpr std::uint32_t project_version_tweak = @CHART_VIEW_BUILD_PROJECT_VERSION_TWEAK@;
inline constexpr bool enable_qt_rhi = @CHART_VIEW_BUILD_ENABLE_QT_RHI@ != 0;
inline constexpr bool enable_s57 = @CHART_VIEW_BUILD_ENABLE_S57@ != 0;
inline constexpr bool enable_cm93 = @CHART_VIEW_BUILD_ENABLE_CM93@ != 0;
inline constexpr bool enable_s101 = @CHART_VIEW_BUILD_ENABLE_S101@ != 0;
}// namespace chart_view::build

#endif
