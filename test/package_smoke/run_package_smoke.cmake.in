set(package_install_dir "@CMAKE_BINARY_DIR@/package-smoke/install")
set(package_build_dir "@CMAKE_BINARY_DIR@/package-smoke/build")
set(package_prefix_path "@chart_view_package_prefix_path@")

if(NOT DEFINED CHART_VIEW_TEST_CONFIG OR CHART_VIEW_TEST_CONFIG STREQUAL "")
  set(CHART_VIEW_TEST_CONFIG "@CMAKE_BUILD_TYPE@")
endif()

file(REMOVE_RECURSE "${package_install_dir}")
file(REMOVE_RECURSE "${package_build_dir}")

set(install_command "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@" --prefix "${package_install_dir}")
if(NOT CHART_VIEW_TEST_CONFIG STREQUAL "")
  list(APPEND install_command --config "${CHART_VIEW_TEST_CONFIG}")
endif()

execute_process(COMMAND ${install_command} RESULT_VARIABLE install_result)
if(NOT install_result EQUAL 0)
  message(FATAL_ERROR "Package smoke install failed with exit code ${install_result}")
endif()

execute_process(
  COMMAND "@CMAKE_COMMAND@" -S "@CMAKE_CURRENT_SOURCE_DIR@/package_smoke" -B "${package_build_dir}" "-DCMAKE_PREFIX_PATH=${package_prefix_path}"
  RESULT_VARIABLE configure_result)
if(NOT configure_result EQUAL 0)
  message(FATAL_ERROR "Package smoke configure failed with exit code ${configure_result}")
endif()

set(build_command "@CMAKE_COMMAND@" --build "${package_build_dir}")
if(NOT CHART_VIEW_TEST_CONFIG STREQUAL "")
  list(APPEND build_command --config "${CHART_VIEW_TEST_CONFIG}")
endif()

execute_process(COMMAND ${build_command} RESULT_VARIABLE build_result)
if(NOT build_result EQUAL 0)
  message(FATAL_ERROR "Package smoke build failed with exit code ${build_result}")
endif()
