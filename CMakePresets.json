{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 29,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "description": "Windows-first DLL skeleton using MSVC, Qt 6, and Ninja Multi-Config",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "chart_view_BUILD_RUNTIME": "ON",
        "chart_view_BUILD_QTWIDGETS": "ON",
        "chart_view_BUILD_STANDALONE": "ON",
        "chart_view_BUILD_TESTS": "ON",
        "chart_view_ENABLE_CLANG_TIDY": "OFF",
        "chart_view_ENABLE_CPPCHECK": "OFF",
        "CMAKE_TOOLCHAIN_FILE": "C:/Users/zsh/source/repos/vcpkg-2026.03.18/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.11.0/vs2026_64_shared_dbg_rel",
        "CHARTSYS_ENABLE_REAL_CHART_TESTS": "ON",
        "CHARTSYS_S57_TESTDATA_ROOT": "C:/Users/zsh/Documents/chart_testdata/s57",
        "CHARTSYS_CM93_TESTDATA_ROOT": "C:/Users/zsh/Documents/chart_testdata/cm93"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC RelWithDebInfo",
      "description": "Release-oriented Windows-first DLL skeleton using MSVC, Qt 6, and Ninja Multi-Config",
      "inherits": "windows-msvc-debug",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}"
    }
  ],
  "buildPresets": [
    {
      "name": "build-windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "build-windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "test-windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "test-windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    }
  ]
}
